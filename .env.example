# Copy to .env and adjust. Everything has a working default; no keys are required.

# Host port for the website (http://localhost:8080).
WEB_PORT=8080

# Postgres credentials (internal to the compose network).
POSTGRES_USER=inkspect
POSTGRES_PASSWORD=inkspect
POSTGRES_DB=inkspect
# Use an external Postgres instead of the bundled db service (SQLAlchemy URL, psycopg driver):
# DATABASE_URL=postgresql+psycopg://user:password@prod-host:5432/inkspect

# Token for the /admin pages (review, region editor, training export). Change it.
ADMIN_TOKEN=dev-admin

# Response coder: rule (default, no key needed) | llm | laya
CODER=rule
# Needed only for CODER=llm.
ANTHROPIC_API_KEY=
# Optional model override for CODER=llm.
LLM_MODEL=
# Only for CODER=laya (started with --profile laya).
LAYA_URL=http://laya:8100
LAYA_CHECKPOINT=
